# Copiá este archivo como .env.local y cargá los mismos valores en Vercel
# (Settings -> Environment Variables). NUNCA subas .env.local a GitHub.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (solo servidor: nunca con NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Panel /admin: una contraseña larga
ADMIN_PASSWORD=

# Mails (resend.com)
RESEND_API_KEY=
ADMIN_EMAIL=

# Datos de cobro por transferencia (se muestran al comprador en el checkout y en los mails)
NEXT_PUBLIC_BANK_CBU=
NEXT_PUBLIC_BANK_ALIAS=
# Opcional: si se deja vacío, no se muestra el titular
NEXT_PUBLIC_BANK_HOLDER=
# WhatsApp para el comprobante, formato internacional sin + (ej: 5491112345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Pago online con tarjeta (Naranja X): solo si se activa ONLINE_PAYMENT_ENABLED
NARANJAX_API_URL=
NARANJAX_CLIENT_ID=
NARANJAX_CLIENT_SECRET=
NARANJAX_WEBHOOK_SECRET=
